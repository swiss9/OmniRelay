{
  "manifest_version": 2,
  "name": "OmniRelay",
  "version": "1.0.0",
  "description": "Send web content to Telegram & Discord with one click.",
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon.png"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "notifications",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "OmniRelay"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "omnirelay@swiss9.addon",
      "data_collection_permissions": []
    }
  }
}
